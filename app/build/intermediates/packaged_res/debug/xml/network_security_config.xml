<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Разрешаем только HTTPS для всех доменов по умолчанию -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

    <!-- Специфичные настройки для FunPay -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">funpay.com</domain>
        <domain includeSubdomains="true">funpay.ru</domain>
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </domain-config>
</network-security-config>
